# Copie para .env e preencha. NUNCA versione o .env.
NODE_ENV=production

# Domínio público (HTTPS via Caddy) e origem usada na proteção CSRF.
APP_DOMAIN=monitor.seudominio.com.br
APP_ORIGIN=https://monitor.seudominio.com.br

# Banco (docker-compose monta DATABASE_URL a partir desta senha).
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
# Fora do docker-compose, informe a URL completa:
# DATABASE_URL=postgres://usuario:senha@host:5432/fza_monitor
# DATABASE_SSL=true

SESSION_TTL_HOURS=12
LOG_LEVEL=info

# Fonte oficial: Meta — Instagram Business Discovery (ver docs/PROVEDOR-META.md)
META_GRAPH_API_VERSION=v25.0
META_IG_USER_ID=
META_ACCESS_TOKEN=
# Opcional (recomendado): ativa appsecret_proof
META_APP_SECRET=

# Somente para desenvolvimento local. Proibido em produção.
ALLOW_DEMO_PROVIDER=false

WORKER_POLL_SECONDS=15
BACKUP_KEEP_DAYS=14
