{
  "name": "fza-instagram-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "FZA Instagram Monitor - monitoramento de perfis públicos do Instagram",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start:server": "node dist/server/index.js",
    "start:worker": "node dist/worker/index.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "migrate:prod": "node dist/db/migrate-cli.js",
    "user:create": "tsx src/cli/create-user.ts",
    "provider:check": "tsx src/cli/provider-check.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  }
}
