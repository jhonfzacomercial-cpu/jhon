{
  "name": "fza-gestao",
  "private": true,
  "version": "1.0.0",
  "description": "Painel de comando gerencial pessoal — Grupo FZA",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed-cli.js",
    "test": "node --disable-warning=ExperimentalWarning --test server/tests/*.test.js",
    "build:artifact": "vite build --config vite.artifact.config.js && node scripts/artifact.js"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.14.2",
    "vite": "^8.3.3"
  }
}
